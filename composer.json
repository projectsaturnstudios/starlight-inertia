{
    "name": "projectsaturnstudios/starlight-inertia",
    "description": "A Starlight-shaped documentation theme for Laravel + Inertia (Vue): tokens, chrome, markdown styling and the markdown renderer that matches it.",
    "type": "library",
    "version": "0.10.0",
    "license": "MIT",
    "keywords": ["laravel", "inertia", "vue", "docs", "starlight", "theme"],
    "authors": [
        {"name": "Angel Gonzalez", "email": "usftechacg@gmail.com"}
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "league/commonmark": "^2.6",
        "phiki/phiki": "^2.2",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "ProjectSaturnStudios\\Themes\\Starlight\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProjectSaturnStudios\\Themes\\Starlight\\Providers\\StarlightServiceProvider"
            ]
        }
    }
}
